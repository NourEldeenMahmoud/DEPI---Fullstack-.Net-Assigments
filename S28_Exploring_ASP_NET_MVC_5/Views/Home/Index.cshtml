@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">@ViewBag.Message</h1>
    <p>@ViewBag.Description</p>
    
    <div style="margin-top: 30px;">
        <h3>MVC Components:</h3>
        <ul style="text-align: left; display: inline-block;">
            <li><strong>Model:</strong> Represents data and business logic</li>
            <li><strong>View:</strong> Displays data to the user</li>
            <li><strong>Controller:</strong> Handles user input and coordinates</li>
        </ul>
    </div>
</div>

