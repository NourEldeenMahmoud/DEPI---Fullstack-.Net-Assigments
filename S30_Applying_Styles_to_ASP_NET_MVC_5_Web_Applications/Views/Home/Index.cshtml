@{
    ViewData["Title"] = "Styled MVC Page";
}

<style>
    .styled-box {
        border: 2px solid #4CAF50;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
        background-color: #f9f9f9;
    }
    .student-info {
        color: #333;
        font-weight: bold;
    }
</style>

<div class="styled-box">
    <h1 class="student-info">Styled Student Information</h1>
    <p><strong>Student:</strong> Ahmed Ali</p>
    <p><strong>Grade:</strong> 85</p>
    <p><strong>Status:</strong> <span style="color: green;">PASS</span></p>
</div>

