@{
    ViewData["Title"] = "MVC Structure";
}

<h1>MVC Application Structure</h1>
<h2>Controllers:</h2>
<ul>
    @foreach (var c in ViewBag.Controllers)
    {
        <li>@c</li>
    }
</ul>
<h2>Models:</h2>
<ul>
    @foreach (var m in ViewBag.Models)
    {
        <li>@m</li>
    }
</ul>
<h2>Views:</h2>
<ul>
    @foreach (var v in ViewBag.Views)
    {
        <li>@v</li>
    }
</ul>

